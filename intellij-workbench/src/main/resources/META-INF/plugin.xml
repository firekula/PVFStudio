<idea-plugin>
    <id>studio.pvf.workbench</id>
    <name>PVF Studio Workbench</name>
    <vendor>PVF Studio contributors</vendor>
    <description>PVF archive browser, script editor, persistent drafts and verified export.</description>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <appStarter id="pvf-studio" implementation="studio.pvf.intellij.PvfStudioStarter"/>
        <appStarter id="pvf-studio-smoke" implementation="studio.pvf.intellij.PvfStudioSmokeStarter"/>
    </extensions>
</idea-plugin>
