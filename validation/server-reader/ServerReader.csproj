<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DFLegacyRoot Condition="'$(DFLegacyRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\DFLegacy</DFLegacyRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(DFLegacyRoot)/src/DFLegacy.Protocol/PvfArchiveReader.cs" Link="PvfArchiveReader.cs" />
  </ItemGroup>
</Project>
